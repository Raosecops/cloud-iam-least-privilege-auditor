{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowCoreAppAndStorageServices",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ExplicitlyDenyPrivilegeEscalationAndIAMTampering",
            "Effect": "Deny",
            "Action": [
                "iam:CreateUser",
                "iam:DeleteUser",
                "iam:AttachUserPolicy",
                "iam:PutUserPolicy",
                "iam:CreatePolicyVersion",
                "iam:SetDefaultPolicyVersion",
                "sts:AssumeRole"
            ],
            "Resource": "*"
        }
    ]
}
